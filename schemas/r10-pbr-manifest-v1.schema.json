{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kodepoia.local/schemas/r10-pbr-manifest-v1.schema.json","title":"Kodepoia R10.4 UV/PBR manifest v1","type":"object","additionalProperties":false,"required":["schema","version","source_sha","policy_version","recipe_id","recipe_digest","input_blend_sha256","status","blockers","objects","materials","artifact","bake","process"],"properties":{"schema":{"const":"kodepoia.blender.pbr_manifest"},"version":{"const":1},"source_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"policy_version":{"const":"r10.4-v1"},"recipe_id":{"type":"string"},"recipe_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"input_blend_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"enum":["pass","fail"]},"blockers":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"objects":{"type":"object"},"materials":{"type":"object"},"artifact":{"type":["object","null"]},"bake":{"type":"object","additionalProperties":false,"required":["requested","executed"],"properties":{"requested":{"const":false},"executed":{"const":false}}},"process":{"type":"object"}}}