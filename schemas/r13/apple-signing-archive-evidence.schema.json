{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/apple-signing-archive-evidence.schema.json",
  "title": "Kodepoia R13 Apple signing/archive hosted evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha",
    "definition_sha256",
    "workspace_manifest_sha256",
    "xcode_version",
    "iphoneos_sdk_version",
    "iphonesimulator_sdk_version",
    "simulator_build_succeeded",
    "unsigned_archive_succeeded",
    "archive_info_present",
    "archive_product_present",
    "code_signing_allowed",
    "code_signing_required",
    "archive_metadata_readiness",
    "distribution_signing_capable",
    "distribution_credentials_required",
    "export_method",
    "export_options_prepared",
    "export_attempted",
    "account_or_signing_credential_used",
    "physical_device_capability_proven",
    "live_app_store_acceptance_claimed",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "xcode_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "iphoneos_sdk_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "iphonesimulator_sdk_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "simulator_build_succeeded": {"const": true},
    "unsigned_archive_succeeded": {"const": true},
    "archive_info_present": {"const": true},
    "archive_product_present": {"const": true},
    "code_signing_allowed": {"const": false},
    "code_signing_required": {"const": false},
    "archive_metadata_readiness": {"const": "DISTRIBUTION_CREDENTIALS_REQUIRED"},
    "distribution_signing_capable": {"const": false},
    "distribution_credentials_required": {"const": true},
    "export_method": {"const": "APP_STORE_CONNECT"},
    "export_options_prepared": {"const": true},
    "export_attempted": {"const": false},
    "account_or_signing_credential_used": {"const": false},
    "physical_device_capability_proven": {"const": false},
    "live_app_store_acceptance_claimed": {"const": false},
    "blockers": {"type": "array", "maxItems": 0}
  }
}
