{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kodepoia.local/schemas/r10-retarget-recipe-v1.schema.json",
  "title":"Kodepoia R10.7 Retarget Recipe v1",
  "type":"object",
  "additionalProperties":false,
  "required":["version","recipe_id","input_blend_sha256","source_rig","target_rig","clip","mappings","required_target_bones","translation_scale","max_keys"],
  "properties":{
    "version":{"const":1},
    "recipe_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},
    "input_blend_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_rig":{"type":"object"},
    "target_rig":{"type":"object"},
    "clip":{"type":"object"},
    "mappings":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object"}},
    "required_target_bones":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"type":"string"}},
    "translation_scale":{"type":"number","exclusiveMinimum":0},
    "max_keys":{"type":"integer","minimum":1,"maximum":250000}
  }
}
