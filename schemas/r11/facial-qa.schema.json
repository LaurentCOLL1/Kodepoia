{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r11/facial-qa.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "curve_set_digest", "total_curves", "total_keys", "clipped_keys", "blockers", "warnings"],
  "properties": {
    "status": {"enum": ["PASS", "WARN", "FAIL"]},
    "curve_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "total_curves": {"type": "integer", "minimum": 0},
    "total_keys": {"type": "integer", "minimum": 0},
    "clipped_keys": {"type": "integer", "minimum": 0},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
