{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/official-doc-manifest-v1.schema.json",
  "title": "Kodepoia Official Documentation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "local_root", "canonical_base_url", "publisher", "product"],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "key": {"type": "string", "minLength": 1},
          "local_root": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          },
          "canonical_base_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
          },
          "publisher": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "domain": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
