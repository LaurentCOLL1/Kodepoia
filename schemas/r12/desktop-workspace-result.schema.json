{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r12/desktop-workspace-result.schema.json",
  "title": "Kodepoia R12 Desktop Workspace Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "state",
    "project_root",
    "project_name",
    "framework",
    "architecture",
    "package_kind",
    "blockers",
    "evidence",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"enum": ["status", "scaffold", "validate", "build", "test", "package"]},
    "state": {"enum": ["ready", "pass", "blocked", "failed", "cancelled"]},
    "project_root": {"type": "string", "minLength": 1},
    "project_name": {"type": ["string", "null"]},
    "framework": {"type": ["string", "null"]},
    "architecture": {"type": ["string", "null"]},
    "package_kind": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "object"},
    "summary": {"type": "string", "minLength": 1}
  }
}
