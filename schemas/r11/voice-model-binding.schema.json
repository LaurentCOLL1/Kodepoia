{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.invalid/schemas/r11/voice-model-binding.schema.json",
  "type": "object",
  "required": ["binding_id", "backend_id", "model_sha256", "config_sha256", "locale", "rights", "speaker_id", "display_label"],
  "additionalProperties": false,
  "properties": {
    "binding_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "backend_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locale": {"type": "string", "minLength": 2, "maxLength": 63},
    "speaker_id": {"type": ["string", "null"], "maxLength": 128},
    "display_label": {"type": "string", "minLength": 1, "maxLength": 128},
    "rights": {
      "type": "object",
      "required": ["provenance_id", "license_id", "allowed_uses", "source_uri_id", "authorization_ref", "requires_authorization", "state"],
      "additionalProperties": false,
      "properties": {
        "provenance_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "license_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "allowed_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["internal", "noncommercial", "commercial", "redistribution", "derivative"]}},
        "source_uri_id": {"type": ["string", "null"], "maxLength": 128},
        "authorization_ref": {"type": ["string", "null"], "maxLength": 128},
        "requires_authorization": {"type": "boolean"},
        "state": {"enum": ["AVAILABLE", "RIGHTS_BLOCKED"]}
      }
    }
  }
}
