{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/github-research-evidence-v1.schema.json",
  "title": "Kodepoia R7.4 GitHub research evidence metadata v1",
  "type": "object",
  "required": [
    "github_schema_version",
    "owner",
    "repo",
    "resource_kind",
    "api_urls",
    "api_version",
    "pages",
    "pagination_truncated",
    "rate_limits",
    "exact_commit_sha"
  ],
  "properties": {
    "github_schema_version": {"const": 1},
    "owner": {"type": "string", "minLength": 1, "maxLength": 100},
    "repo": {"type": "string", "minLength": 1, "maxLength": 100},
    "resource_kind": {
      "enum": [
        "repository",
        "file",
        "blob",
        "commit",
        "releases",
        "tags",
        "issue",
        "issue_comments",
        "pull_request",
        "pull_comments"
      ]
    },
    "api_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^https://api\\.github\\.com/repos/"
      }
    },
    "api_version": {"const": "2022-11-28"},
    "pages": {"type": "integer", "minimum": 1, "maximum": 20},
    "pagination_truncated": {"type": "boolean"},
    "rate_limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "limit",
          "remaining",
          "used",
          "reset_epoch",
          "resource",
          "retry_after"
        ],
        "properties": {
          "limit": {"type": ["integer", "null"], "minimum": 0},
          "remaining": {"type": ["integer", "null"], "minimum": 0},
          "used": {"type": ["integer", "null"], "minimum": 0},
          "reset_epoch": {"type": ["integer", "null"], "minimum": 0},
          "resource": {"type": "string"},
          "retry_after": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "exact_commit_sha": {
      "type": "string",
      "pattern": "^(?:|[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "additionalProperties": false
}
