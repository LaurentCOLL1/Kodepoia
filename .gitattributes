* text=auto

*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Deterministic protocol fixtures/evidence hashed byte-for-byte in cross-platform CI
tests/fixtures/comfyui/*.json text eol=lf
docs/roadmap/*_LOCAL_ACCEPTANCE.json text eol=lf

# R16.10 representative Godot fixture is byte-bound across CI platforms.
tests/fixtures/r16_10_godot_2d_beta/** text eol=lf

# R15.17 canonical integrated evidence is byte-bound to repository blobs.
# Keep these sources LF on Windows so exact SHA-256 bindings are checkout-invariant.
docs/roadmap/R14_INTEGRATED_ACCEPTANCE.json text eol=lf
docs/roadmap/R15*.md text eol=lf
docs/roadmap/R15*.json text eol=lf

# Git LFS — heavy/non-mergeable source assets
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
