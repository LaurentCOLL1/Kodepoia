{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/architecture-freeze.schema.json",
  "title": "Kodepoia Architecture Freeze Manifest",
  "type": "object",
  "required": ["project", "architecture_version", "status", "freeze_date", "documents", "foundation_priorities", "principles"],
  "properties": {
    "project": {"const": "Kodepoia"},
    "former_name": {"type": ["string", "null"]},
    "architecture_version": {"type": "string"},
    "status": {"const": "FROZEN"},
    "freeze_date": {"type": "string", "format": "date"},
    "documents": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "foundation_priorities": {"type": "array", "minItems": 5, "items": {"type": "string"}, "uniqueItems": true},
    "principles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
