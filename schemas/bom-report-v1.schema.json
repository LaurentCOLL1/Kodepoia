{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/bom-report-v1.schema.json",
  "title": "Kodepoia BOM Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "project_name", "inventory_scope", "inventory_complete",
    "inventory_review_source", "spdx_baseline", "spdx_serialization_version", "status", "counts",
    "blockers", "components", "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "project_name": {"type": "string", "minLength": 1},
    "inventory_scope": {"type": "string", "minLength": 1},
    "inventory_complete": {"type": "boolean"},
    "inventory_review_source": {"type": "string"},
    "spdx_baseline": {"const": "3.0"},
    "spdx_serialization_version": {"const": "3.0.1"},
    "status": {"enum": ["unknown", "pass", "warn", "fail"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components_total", "projects", "packages", "assets", "resolved", "unresolved", "integrity_recorded", "integrity_unknown", "integrity_mismatch"],
      "properties": {
        "components_total": {"type": "integer", "minimum": 0},
        "projects": {"type": "integer", "minimum": 0},
        "packages": {"type": "integer", "minimum": 0},
        "assets": {"type": "integer", "minimum": 0},
        "resolved": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "integrity_recorded": {"type": "integer", "minimum": 0},
        "integrity_unknown": {"type": "integer", "minimum": 0},
        "integrity_mismatch": {"type": "integer", "minimum": 0}
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "licenseAssertion": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "evidence_source", "expression", "rationale", "custom_text_sha256", "spdx_token"],
      "properties": {
        "state": {"enum": ["spdx_expression", "noassertion", "none"]},
        "evidence_source": {"type": "string", "minLength": 1},
        "expression": {"type": "string"},
        "rationale": {"type": "string"},
        "custom_text_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "spdx_token": {"type": "string", "minLength": 1}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source", "algorithm", "digest", "expected_digest"],
      "properties": {
        "status": {"enum": ["recorded", "mismatch", "unknown", "not_applicable"]},
        "source": {"type": "string", "minLength": 1},
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "expected_digest": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["group", "requirement", "source"],
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "resolution", "version", "purl", "source_locator", "provenance_source", "source_sha256", "integrity", "declared_license", "concluded_license", "requirements", "details"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{1,191}$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["project", "package", "asset"]},
        "resolution": {"enum": ["resolved", "unresolved", "not_applicable"]},
        "version": {"type": "string"},
        "purl": {"type": "string"},
        "source_locator": {"type": "string", "minLength": 1},
        "provenance_source": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "integrity": {"$ref": "#/$defs/integrity"},
        "declared_license": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/licenseAssertion"}]},
        "concluded_license": {"$ref": "#/$defs/licenseAssertion"},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "details": {"type": "object"}
      }
    }
  }
}
