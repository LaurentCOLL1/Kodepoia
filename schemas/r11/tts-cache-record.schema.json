{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.invalid/schemas/r11/tts-cache-record.schema.json",
  "type": "object",
  "required": ["cache_key", "asset_revision_id", "output_sha256", "runtime_sha256", "model_sha256", "config_sha256"],
  "additionalProperties": false,
  "properties": {
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
