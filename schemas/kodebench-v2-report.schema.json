{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/kodebench-v2-report.schema.json",
  "title": "KodeBench v2 report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "suite",
    "suite_digest",
    "config",
    "config_digest",
    "model_identities",
    "outcomes",
    "protection_manifest_digest",
    "summary",
    "report_digest"
  ],
  "properties": {
    "schema": {"const": "kodepoia.kodebench.v2.report"},
    "schema_version": {"const": 1},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "version", "tasks"],
      "properties": {
        "suite_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "domain",
              "critical",
              "prompt_digest",
              "scorer",
              "scorer_digest",
              "tools_digest",
              "protected_holdout_id"
            ],
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "domain": {"type": "string", "minLength": 1},
              "critical": {"type": "boolean"},
              "prompt_digest": {"$ref": "#/$defs/digest"},
              "scorer_digest": {"$ref": "#/$defs/digest"},
              "tools_digest": {"$ref": "#/$defs/digest"},
              "protected_holdout_id": {"type": ["string", "null"]},
              "scorer": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name", "version", "config"],
                "properties": {
                  "kind": {
                    "enum": ["exact", "contains", "regex", "json_schema", "tool_call", "custom"]
                  },
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1},
                  "config": {"type": "object"}
                }
              }
            }
          }
        }
      }
    },
    "suite_digest": {"$ref": "#/$defs/digest"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "repeats", "seed_base", "temperature", "num_predict"],
      "properties": {
        "role": {"enum": ["baseline", "fast", "core", "coder"]},
        "repeats": {"type": "integer", "minimum": 1, "maximum": 8},
        "seed_base": {"type": "integer"},
        "temperature": {"type": "number", "minimum": 0},
        "num_predict": {"type": "integer", "minimum": 1}
      }
    },
    "config_digest": {"$ref": "#/$defs/digest"},
    "model_identities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_ref", "model_digest", "resolved", "runtime", "runtime_version"],
        "properties": {
          "model_ref": {"type": "string", "minLength": 1},
          "model_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
          "resolved": {"type": "boolean"},
          "runtime": {"type": "string", "minLength": 1},
          "runtime_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_ref",
          "task_id",
          "domain",
          "critical",
          "repeat",
          "seed",
          "passed",
          "category",
          "scorer_digest",
          "response_digest",
          "resources",
          "error"
        ],
        "properties": {
          "model_ref": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "critical": {"type": "boolean"},
          "repeat": {"type": "integer", "minimum": 1},
          "seed": {"type": "integer"},
          "passed": {"type": "boolean"},
          "category": {
            "enum": ["pass", "model_failure", "capability_unavailable", "scorer_failure", "wrong_answer"]
          },
          "scorer_digest": {"$ref": "#/$defs/digest"},
          "response_digest": {"$ref": "#/$defs/digest"},
          "error": {"type": ["string", "null"]},
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "elapsed_s",
              "tokens_per_second",
              "load_s",
              "total_s",
              "eval_count",
              "prompt_eval_count",
              "vram_bytes",
              "model_size_bytes"
            ],
            "properties": {
              "elapsed_s": {"type": "number", "minimum": 0},
              "tokens_per_second": {"type": ["number", "null"], "minimum": 0},
              "load_s": {"type": ["number", "null"], "minimum": 0},
              "total_s": {"type": ["number", "null"], "minimum": 0},
              "eval_count": {"type": ["integer", "null"], "minimum": 0},
              "prompt_eval_count": {"type": ["integer", "null"], "minimum": 0},
              "vram_bytes": {"type": ["integer", "null"], "minimum": 0},
              "model_size_bytes": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      }
    },
    "protection_manifest_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "summary": {"type": "object"},
    "report_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
