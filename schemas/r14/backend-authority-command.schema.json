{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r14/backend-authority-command.schema.json",
  "title": "Kodepoia R14.6 authoritative command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "domain_id",
    "actor_id",
    "session_id",
    "command_type",
    "target_id",
    "expected_revision",
    "sequence",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "domain_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "actor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "command_type": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "payload": {"type": "object"}
  }
}
