{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/ci-report-v1.schema.json",
  "title": "Kodepoia CI Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "workflow_id", "source_sha", "status", "checks", "counts", "blocking_checks", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "workflow_id": {"type": "string", "minLength": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["pass", "warn", "fail", "unknown"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required", "source", "message", "details"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["queued", "in_progress", "pass", "fail", "cancelled", "skipped", "unknown"]},
          "required": {"type": "boolean"},
          "source": {"type": "string"},
          "message": {"type": "string"},
          "details": {"type": "object"}
        }
      }
    },
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "blocking_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
