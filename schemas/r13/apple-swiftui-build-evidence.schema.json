{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/apple-swiftui-build-evidence.schema.json",
  "title": "Kodepoia R13.9 Apple SwiftUI Build Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha",
    "definition_sha256",
    "workspace_manifest_sha256",
    "app_model_sha256",
    "xcode_version",
    "xcode_build",
    "iphonesimulator_sdk_version",
    "destination",
    "scheme",
    "build_configuration",
    "code_signing_allowed",
    "code_signing_required",
    "build_succeeded",
    "app_bundle_present",
    "app_executable_sha256",
    "state_strategy",
    "physical_device_capability_proven",
    "account_or_signing_credential_used",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "app_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "xcode_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"},
    "xcode_build": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "iphonesimulator_sdk_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"},
    "destination": {"const": "generic/platform=iOS Simulator"},
    "scheme": {"const": "KodepoiaIOS"},
    "build_configuration": {"const": "Debug"},
    "code_signing_allowed": {"const": false},
    "code_signing_required": {"const": false},
    "build_succeeded": {"const": true},
    "app_bundle_present": {"const": true},
    "app_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_strategy": {"enum": ["observation", "observable_object_compat"]},
    "physical_device_capability_proven": {"const": false},
    "account_or_signing_credential_used": {"const": false},
    "blockers": {"type": "array", "maxItems": 0}
  }
}
