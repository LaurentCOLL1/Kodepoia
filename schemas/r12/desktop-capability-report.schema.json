{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r12/desktop-capability-report-v1.schema.json",
  "title": "Kodepoia R12 desktop capability report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_id", "state", "toolchain", "capabilities", "blockers"],
  "properties": {
    "adapter_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": {
      "enum": ["NOT_PROBED", "AVAILABLE", "UNAVAILABLE", "UNSUPPORTED", "BLOCKED", "FAILED"]
    },
    "toolchain": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_kind", "executable_name", "executable_sha256", "version", "platform", "architecture", "capabilities"],
          "properties": {
            "tool_kind": {"enum": ["dotnet", "msbuild", "cmake", "qt_paths", "cargo", "rustc"]},
            "executable_name": {"type": "string", "minLength": 1, "maxLength": 128},
            "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "platform": {"enum": ["windows", "linux", "macos"]},
            "architecture": {"enum": ["x64", "arm64", "x86"]},
            "capabilities": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
    },
    "blockers": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
    }
  }
}
