{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/devicelab-evidence.schema.json",
  "title": "Kodepoia R13.12 DeviceLab Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix",
    "matrix_sha256",
    "route",
    "route_sha256",
    "lease",
    "results",
    "cleanup_complete",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "matrix_sha256": {"$ref": "#/$defs/sha256"},
    "route_sha256": {"$ref": "#/$defs/sha256"},
    "cleanup_complete": {"const": true},
    "status": {"const": "pass"},
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_id", "platform", "artifact_sha256", "test_execution_id", "devices"],
      "properties": {
        "matrix_id": {"$ref": "#/$defs/stable_id"},
        "platform": {"enum": ["ANDROID", "IOS"]},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "test_execution_id": {"$ref": "#/$defs/stable_id"},
        "devices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/device"}
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_sha256", "artifact_sha256", "provider", "provider_capability_sha256", "target_classes"],
      "properties": {
        "matrix_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "provider": {"$ref": "#/$defs/provider"},
        "provider_capability_sha256": {"$ref": "#/$defs/sha256"},
        "target_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["VIRTUAL", "PHYSICAL"]}
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "route_sha256", "matrix_sha256", "artifact_sha256", "timeout_seconds", "retry_limit"],
      "properties": {
        "lease_id": {"$ref": "#/$defs/stable_id"},
        "route_sha256": {"$ref": "#/$defs/sha256"},
        "matrix_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "retry_limit": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stable_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "provider": {"enum": ["LOCAL_ANDROID", "XCODE_SIMULATOR", "HOSTED_CI", "FIREBASE_TEST_LAB"]},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "os_version", "locale", "orientation", "target_class"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "os_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"},
        "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"},
        "orientation": {"enum": ["PORTRAIT", "LANDSCAPE"]},
        "target_class": {"enum": ["VIRTUAL", "PHYSICAL"]}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "provider",
        "matrix_sha256",
        "artifact_sha256",
        "provider_result_sha256",
        "result",
        "target_class",
        "physical_device_proven",
        "cost_micros",
        "blockers"
      ],
      "properties": {
        "source_sha": {"$ref": "#/$defs/source_sha"},
        "provider": {"$ref": "#/$defs/provider"},
        "matrix_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "provider_result_sha256": {"$ref": "#/$defs/sha256"},
        "result": {"const": "PASSED"},
        "target_class": {"enum": ["VIRTUAL", "PHYSICAL"]},
        "physical_device_proven": {"type": "boolean"},
        "cost_micros": {"type": "integer", "minimum": 0, "maximum": 10000000000},
        "blockers": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/stable_id"}}
      }
    }
  }
}
