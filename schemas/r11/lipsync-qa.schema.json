{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kodepoia.invalid/schemas/r11/lipsync-qa.schema.json",
  "type":"object",
  "required":["profile_id","alignment_digest","viseme_timeline_digest","state","blockers","warnings","metrics"],
  "additionalProperties":false,
  "properties":{
    "profile_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "alignment_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "viseme_timeline_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "state":{"enum":["PASS","WARN","BLOCKED","BUDGET_EXCEEDED"]},
    "blockers":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "warnings":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "metrics":{"type":"object","required":["event_count","events_per_second","duration_drift_seconds","max_influence_overlap_seconds","fallback_count","fallback_fraction","min_reported_confidence"],"additionalProperties":false,"properties":{"event_count":{"type":"integer","minimum":0},"events_per_second":{"type":"number","minimum":0},"duration_drift_seconds":{"type":"number","minimum":0},"max_influence_overlap_seconds":{"type":"number","minimum":0},"fallback_count":{"type":"integer","minimum":0},"fallback_fraction":{"type":"number","minimum":0,"maximum":1},"min_reported_confidence":{"type":"number","minimum":0,"maximum":1}}}
  }
}
