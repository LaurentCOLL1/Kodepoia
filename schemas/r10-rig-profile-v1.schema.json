{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kodepoia.local/schemas/r10-rig-profile-v1.schema.json",
  "title":"Kodepoia R10.6 Rig Profile v1",
  "type":"object","additionalProperties":false,
  "required":["version","rig_id","armature_id","mode","input_blend_sha256","bones","meshes","influence"],
  "properties":{
    "version":{"const":1},
    "rig_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},
    "armature_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},
    "mode":{"enum":["create","validate_existing"]},
    "input_blend_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "bones":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["bone_id","display_name","parent_id","head","tail","deform","connected"],"properties":{"bone_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},"display_name":{"type":"string","minLength":1,"maxLength":128},"parent_id":{"type":["string","null"]},"head":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"tail":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"deform":{"type":"boolean"},"connected":{"type":"boolean"}}}},
    "meshes":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["mesh_id","strategy","weights"],"properties":{"mesh_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,63}$"},"strategy":{"enum":["explicit","nearest_deform_bone","existing"]},"weights":{"type":"array","maxItems":250000,"items":{"type":"object","additionalProperties":false,"required":["vertex","influences"],"properties":{"vertex":{"type":"integer","minimum":0,"maximum":50000000},"influences":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["bone_id","weight"],"properties":{"bone_id":{"type":"string"},"weight":{"type":"number","minimum":0.0,"maximum":1.0}}}}}}}}}},
    "influence":{"type":"object","additionalProperties":false,"required":["max_influences","allow_extended_influences","normalization_tolerance","tiny_weight_threshold","require_deformation_probe"],"properties":{"max_influences":{"type":"integer","minimum":1,"maximum":8},"allow_extended_influences":{"type":"boolean"},"normalization_tolerance":{"type":"number","minimum":1e-8,"maximum":0.05},"tiny_weight_threshold":{"type":"number","minimum":0.0,"maximum":0.05},"require_deformation_probe":{"type":"boolean"}}}
  }
}