{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r12/winui-deployment.schema.json",
  "title": "Kodepoia R12 WinUI deployment contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_name", "publisher", "version", "mode", "min_windows_build"],
  "properties": {
    "package_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,49}$"
    },
    "publisher": {
      "type": "string",
      "pattern": "^CN=[A-Za-z0-9 ._-]{1,64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,4})(?:\\.(?:0|[1-9][0-9]{0,4})){3}$"
    },
    "mode": {
      "enum": [
        "packaged_msix",
        "unpackaged_framework_dependent",
        "unpackaged_self_contained"
      ]
    },
    "min_windows_build": {
      "type": "integer",
      "minimum": 17763
    }
  }
}
