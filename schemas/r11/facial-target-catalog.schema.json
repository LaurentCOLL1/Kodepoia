{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r11/facial-target-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_id", "rig_digest", "targets"],
  "properties": {
    "catalog_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "rig_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "semantic", "kind", "minimum", "maximum", "source_digest"],
        "properties": {
          "target_id": {"type": "string"},
          "semantic": {"type": "string"},
          "kind": {"enum": ["blend_shape", "bone"]},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
