{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/asset-record-v1.schema.json",
  "type": "object",
  "required": ["schema", "version", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "kodepoia.asset-record"},
    "version": {"const": 1},
    "payload": {
      "type": "object",
      "required": ["asset_id", "kind", "display_name", "tags", "current_revision_id"],
      "additionalProperties": false,
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"},
        "kind": {"type": "string"},
        "display_name": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "current_revision_id": {"type": ["string", "null"], "pattern": "^rev_[0-9a-f]{32}$"}
      }
    }
  }
}
