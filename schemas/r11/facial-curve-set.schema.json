{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r11/facial-curve-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["curve_set_id", "profile_digest", "viseme_timeline_digest", "target_catalog_digest", "lod_id", "duration_seconds", "clipped_key_count", "curves"],
  "properties": {
    "curve_set_id": {"type": "string"},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "viseme_timeline_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lod_id": {"type": "string"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "clipped_key_count": {"type": "integer", "minimum": 0},
    "curves": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "keys"],
        "properties": {
          "target_id": {"type": "string"},
          "keys": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["time_seconds", "value"], "properties": {"time_seconds": {"type": "number", "minimum": 0}, "value": {"type": "number"}}}}
        }
      }
    }
  }
}
