{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r14/backend-event-pipeline-evidence.schema.json",
  "title": "Kodepoia R14.13 Event Pipeline Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha",
    "status",
    "checks",
    "digests",
    "counts",
    "budgets",
    "manual_state",
    "provider_live_claim",
    "external_broker_required",
    "otel_collector_required",
    "secrets_exposed",
    "pii_exposed",
    "raw_payloads_exposed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "pass"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_schema_identity",
        "secret_field_rejected",
        "credential_field_rejected",
        "unknown_payload_field_rejected",
        "immutable_event_identity",
        "duplicate_deduped",
        "event_id_rebind_rejected",
        "source_out_of_order_rejected",
        "function_authorization",
        "object_authorization",
        "environment_isolation",
        "at_least_once_redelivery",
        "ordered_checkpoint_ack",
        "restart_checkpoint_restore",
        "dead_letter_after_threshold",
        "replay_dry_run_non_mutating",
        "replay_execution_checkpoint_safe",
        "replay_id_rebind_rejected",
        "retention_guard",
        "retention_prune_after_checkpoint",
        "pruned_identity_non_reusable",
        "otel_redaction",
        "cloudevent_v1_interop_shape",
        "bounded_capacity",
        "redacted_evidence"
      ],
      "properties": {
        "immutable_schema_identity": {"const": true},
        "secret_field_rejected": {"const": true},
        "credential_field_rejected": {"const": true},
        "unknown_payload_field_rejected": {"const": true},
        "immutable_event_identity": {"const": true},
        "duplicate_deduped": {"const": true},
        "event_id_rebind_rejected": {"const": true},
        "source_out_of_order_rejected": {"const": true},
        "function_authorization": {"const": true},
        "object_authorization": {"const": true},
        "environment_isolation": {"const": true},
        "at_least_once_redelivery": {"const": true},
        "ordered_checkpoint_ack": {"const": true},
        "restart_checkpoint_restore": {"const": true},
        "dead_letter_after_threshold": {"const": true},
        "replay_dry_run_non_mutating": {"const": true},
        "replay_execution_checkpoint_safe": {"const": true},
        "replay_id_rebind_rejected": {"const": true},
        "retention_guard": {"const": true},
        "retention_prune_after_checkpoint": {"const": true},
        "pruned_identity_non_reusable": {"const": true},
        "otel_redaction": {"const": true},
        "cloudevent_v1_interop_shape": {"const": true},
        "bounded_capacity": {"const": true},
        "redacted_evidence": {"const": true}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event",
        "checkpoint",
        "dead_letter",
        "replay_preview",
        "replay_execute",
        "otel",
        "state",
        "trace"
      ],
      "properties": {
        "schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checkpoint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dead_letter": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "replay_preview": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "replay_execute": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "otel": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trace": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_events",
        "schemas",
        "checkpoints",
        "dead_letters",
        "replays",
        "consumer_lag_events",
        "retained_payload_bytes",
        "acceptance_events_appended"
      ],
      "properties": {
        "retained_events": {"type": "integer", "minimum": 0},
        "schemas": {"type": "integer", "minimum": 0},
        "checkpoints": {"type": "integer", "minimum": 0},
        "dead_letters": {"type": "integer", "minimum": 0},
        "replays": {"type": "integer", "minimum": 0},
        "consumer_lag_events": {"type": "integer", "minimum": 0},
        "retained_payload_bytes": {"type": "integer", "minimum": 0},
        "acceptance_events_appended": {"type": "integer", "minimum": 0}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_schemas",
        "max_events",
        "max_retained_payload_bytes",
        "max_consumers",
        "max_replay_events",
        "max_replay_records",
        "max_dead_letters",
        "max_trace_records"
      ],
      "properties": {
        "max_schemas": {"type": "integer", "minimum": 1},
        "max_events": {"type": "integer", "minimum": 1},
        "max_retained_payload_bytes": {"type": "integer", "minimum": 1},
        "max_consumers": {"type": "integer", "minimum": 1},
        "max_replay_events": {"type": "integer", "minimum": 1},
        "max_replay_records": {"type": "integer", "minimum": 1},
        "max_dead_letters": {"type": "integer", "minimum": 1},
        "max_trace_records": {"type": "integer", "minimum": 1}
      }
    },
    "manual_state": {"const": "none"},
    "provider_live_claim": {"const": false},
    "external_broker_required": {"const": false},
    "otel_collector_required": {"const": false},
    "secrets_exposed": {"const": false},
    "pii_exposed": {"const": false},
    "raw_payloads_exposed": {"const": false}
  }
}
