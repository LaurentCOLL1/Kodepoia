{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/experience-dataset-manifest-v1.schema.json",
  "title": "Kodepoia R15 immutable dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "dataset_id",
    "dataset_digest",
    "policy_digest",
    "policy",
    "dedup_policy_digest",
    "representation_version",
    "entries",
    "split_stats",
    "selection_summary",
    "export_digests"
  ],
  "properties": {
    "schema": {"const": "kodepoia.experience.dataset-manifest"},
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^ds_[0-9a-f]{64}$"},
    "dataset_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "dedup_policy_digest": {"$ref": "#/$defs/digest"},
    "representation_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_domains",
        "allowed_tasks",
        "dedup_policy_digest",
        "duplicate_handling",
        "governance_policy_digest",
        "max_groups_per_domain",
        "sanitizer_digest",
        "seed",
        "split_weights",
        "version"
      ],
      "properties": {
        "allowed_domains": {"$ref": "#/$defs/safe_ids"},
        "allowed_tasks": {"$ref": "#/$defs/safe_ids"},
        "dedup_policy_digest": {"$ref": "#/$defs/digest"},
        "duplicate_handling": {
          "enum": ["representative_only", "keep_group"]
        },
        "governance_policy_digest": {"$ref": "#/$defs/digest"},
        "max_groups_per_domain": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1}
          ]
        },
        "sanitizer_digest": {"$ref": "#/$defs/digest"},
        "seed": {"type": "integer", "minimum": 0},
        "split_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "validation", "test"],
          "properties": {
            "train": {"type": "integer", "minimum": 1},
            "validation": {"type": "integer", "minimum": 1},
            "test": {"type": "integer", "minimum": 0}
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "split_stats": {"$ref": "#/$defs/split_stats"},
    "selection_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excluded_by_reason",
        "input_records",
        "selected_groups",
        "selected_records"
      ],
      "properties": {
        "excluded_by_reason": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "input_records": {"type": "integer", "minimum": 1},
        "selected_groups": {"type": "integer", "minimum": 1},
        "selected_records": {"type": "integer", "minimum": 1}
      }
    },
    "export_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"$ref": "#/$defs/digest"},
        "validation": {"$ref": "#/$defs/digest"},
        "test": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "safe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safe_id"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "split_stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_counts",
        "groups",
        "language_counts",
        "rows",
        "task_counts"
      ],
      "properties": {
        "domain_counts": {"$ref": "#/$defs/counts"},
        "groups": {"type": "integer", "minimum": 0},
        "language_counts": {"$ref": "#/$defs/counts"},
        "rows": {"type": "integer", "minimum": 0},
        "task_counts": {"$ref": "#/$defs/counts"}
      }
    },
    "split_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"$ref": "#/$defs/split_stat"},
        "validation": {"$ref": "#/$defs/split_stat"},
        "test": {"$ref": "#/$defs/split_stat"}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformation_id",
        "input_digest",
        "output_digest",
        "policy_digest"
      ],
      "properties": {
        "transformation_id": {"$ref": "#/$defs/safe_id"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "output_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "example_id",
        "experience_id",
        "format",
        "group_id",
        "language",
        "license_expression",
        "representation_digest",
        "row_digest",
        "source_contract_digest",
        "source_digest",
        "split",
        "task",
        "transformations"
      ],
      "properties": {
        "domain": {"$ref": "#/$defs/safe_id"},
        "example_id": {"type": "string", "pattern": "^ex_[0-9a-f]{64}$"},
        "experience_id": {"type": "string", "pattern": "^exp_[0-9a-f]{64}$"},
        "format": {
          "enum": ["text", "prompt_completion", "conversational"]
        },
        "group_id": {"type": "string", "pattern": "^grp_[0-9a-f]{64}$"},
        "language": {
          "type": "string",
          "pattern": "^([A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*|und)$"
        },
        "license_expression": {"type": "string", "minLength": 1},
        "representation_digest": {"$ref": "#/$defs/digest"},
        "row_digest": {"$ref": "#/$defs/digest"},
        "source_contract_digest": {"$ref": "#/$defs/digest"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "split": {"enum": ["train", "validation", "test"]},
        "task": {"$ref": "#/$defs/safe_id"},
        "transformations": {
          "type": "array",
          "items": {"$ref": "#/$defs/transformation"}
        }
      }
    }
  }
}
