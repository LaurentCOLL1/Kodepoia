{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/android-build-evidence.schema.json",
  "title": "Kodepoia R13.4 Android Build Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha", "runner_os", "source_workspace_manifest_sha256", "overlay_manifest_sha256", "toolchain", "request", "status", "duration_seconds", "artifacts", "blockers"],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_os": {"enum": ["Linux", "Windows"]},
    "source_workspace_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "overlay_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "android_gradle_plugin", "gradle_version", "kotlin_version", "compose_bom", "compile_sdk", "build_tools_version", "jdk_major", "observed_on", "source_urls"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
        "android_gradle_plugin": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"},
        "gradle_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"},
        "kotlin_version": {"type": "string", "minLength": 5, "maxLength": 64},
        "compose_bom": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$"},
        "compile_sdk": {"type": "integer", "minimum": 1, "maximum": 1000},
        "build_tools_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "jdk_major": {"type": "integer", "minimum": 8, "maximum": 99},
        "observed_on": {"type": "string", "format": "date"},
        "source_urls": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://developer\\.android\\.com/"}}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_id", "min_sdk", "target_sdk", "tasks", "timeout_seconds", "max_artifact_bytes"],
      "properties": {
        "application_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "min_sdk": {"type": "integer", "minimum": 1, "maximum": 1000},
        "target_sdk": {"type": "integer", "minimum": 1, "maximum": 1000},
        "tasks": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["unit_test", "apk_debug", "aab_release"]}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 21474836480}
      }
    },
    "status": {"enum": ["pass", "fail", "blocked"]},
    "duration_seconds": {"type": "number", "minimum": 0, "maximum": 7200},
    "artifacts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/artifact"}},
    "blockers": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "size_bytes", "entry_count", "total_uncompressed_bytes", "abis", "required_entries"],
      "properties": {
        "kind": {"enum": ["apk", "aab"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "entry_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "total_uncompressed_bytes": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "abis": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "required_entries": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "pass"}}}, "then": {"properties": {"blockers": {"maxItems": 0}, "artifacts": {"minItems": 2, "maxItems": 2}}}},
    {"if": {"properties": {"status": {"enum": ["fail", "blocked"]}}}, "then": {"properties": {"blockers": {"minItems": 1}}}}
  ]
}
