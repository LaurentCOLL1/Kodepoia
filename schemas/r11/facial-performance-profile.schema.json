{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r11/facial-performance-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "target_catalog_digest", "viseme_set_digest", "mappings", "lod_levels", "clamp_out_of_range"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "viseme_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clamp_out_of_range": {"type": "boolean"},
    "mappings": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"type": "object", "additionalProperties": false, "required": ["source_semantic", "target_id", "weight"], "properties": {"source_semantic": {"type": "string"}, "target_id": {"type": "string"}, "weight": {"type": "number"}}}},
    "lod_levels": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["lod_id", "included_target_ids", "max_keys_per_second", "required_semantics"], "properties": {"lod_id": {"type": "string"}, "included_target_ids": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string"}, "uniqueItems": true}, "max_keys_per_second": {"type": "integer", "minimum": 1, "maximum": 240}, "required_semantics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}}
  }
}
