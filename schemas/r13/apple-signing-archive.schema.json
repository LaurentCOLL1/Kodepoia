{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/apple-signing-archive.schema.json",
  "title": "Kodepoia R13 Apple signing/archive definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "scheme",
    "signing_mode",
    "export_method",
    "team_id",
    "profile_uuid",
    "certificate_sha256",
    "capabilities",
    "entitlements",
    "privacy_manifest_required",
    "secrets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*)+$", "maxLength": 255},
    "scheme": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "signing_mode": {"enum": ["UNSIGNED_SIMULATOR", "DEVELOPMENT", "AD_HOC", "APP_STORE"]},
    "export_method": {"enum": ["NONE", "DEVELOPMENT", "AD_HOC", "APP_STORE_CONNECT"]},
    "team_id": {"type": ["string", "null"], "pattern": "^[A-Z0-9]{10}$"},
    "profile_uuid": {"type": ["string", "null"], "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"},
    "certificate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["PUSH_NOTIFICATIONS", "ASSOCIATED_DOMAINS", "APP_GROUPS"]}
    },
    "entitlements": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "application-identifier",
          "com.apple.developer.team-identifier",
          "get-task-allow",
          "keychain-access-groups",
          "aps-environment",
          "com.apple.developer.associated-domains",
          "com.apple.security.application-groups"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {"type": "boolean"},
          {"type": "integer"},
          {"type": "string", "minLength": 1, "maxLength": 4096},
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        ]
      }
    },
    "privacy_manifest_required": {"type": "boolean"},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signing_certificate", "signing_certificate_password", "provisioning_profile"],
      "properties": {
        "signing_certificate": {"$ref": "#/$defs/secretRefOrNull"},
        "signing_certificate_password": {"$ref": "#/$defs/secretRefOrNull"},
        "provisioning_profile": {"$ref": "#/$defs/secretRefOrNull"}
      }
    }
  },
  "$defs": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1, "maxLength": 256},
        "key": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "secretRefOrNull": {
      "oneOf": [{"$ref": "#/$defs/secretRef"}, {"type": "null"}]
    }
  }
}
