{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/experience-capture-v1.schema.json",
  "title": "Kodepoia Validated Experience Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "event_key",
    "event_id",
    "request_digest",
    "record_digest",
    "policy_digest",
    "validator_id",
    "validation_ref",
    "action_ref",
    "result_ref",
    "correction",
    "record"
  ],
  "properties": {
    "schema": {"const": "kodepoia.experience.capture"},
    "schema_version": {"const": 1},
    "event_key": {"$ref": "#/$defs/digest"},
    "event_id": {"$ref": "#/$defs/safeId"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "record_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "validator_id": {"$ref": "#/$defs/safeId"},
    "validation_ref": {"$ref": "#/$defs/safeId"},
    "action_ref": {"$ref": "#/$defs/safeId"},
    "result_ref": {"$ref": "#/$defs/safeId"},
    "correction": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "original_experience_id",
            "original_workspace_id",
            "original_project_id",
            "original_content_digest",
            "evaluator_id"
          ],
          "properties": {
            "original_experience_id": {
              "type": "string",
              "pattern": "^exp_[0-9a-f]{64}$"
            },
            "original_workspace_id": {"$ref": "#/$defs/safeId"},
            "original_project_id": {"$ref": "#/$defs/safeId"},
            "original_content_digest": {"$ref": "#/$defs/digest"},
            "evaluator_id": {"$ref": "#/$defs/safeId"}
          }
        }
      ]
    },
    "record": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
