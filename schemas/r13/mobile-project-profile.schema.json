{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/mobile-project-profile.schema.json",
  "title": "Kodepoia R13 mobile Project DNA profile",
  "type": "object",
  "required": [
    "source_kind",
    "form_factors",
    "android_application_id",
    "android_min_api",
    "android_target_api",
    "apple_bundle_id",
    "apple_min_version",
    "apple_target_version",
    "package_kinds",
    "permissions",
    "requested_capabilities",
    "network_intent",
    "release_channel",
    "signing_intent",
    "budget"
  ],
  "properties": {
    "source_kind": {"enum": ["native", "godot_export"]},
    "form_factors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["phone", "tablet"]}
    },
    "android_application_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "android_min_api": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000},
    "android_target_api": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000},
    "apple_bundle_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"
    },
    "apple_min_version": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
    },
    "apple_target_version": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
    },
    "package_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["apk", "aab", "app", "xcarchive", "ipa"]}
    },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"}
    },
    "requested_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"}
    },
    "network_intent": {"enum": ["offline", "optional", "required"]},
    "release_channel": {"enum": ["development", "internal", "beta", "production"]},
    "signing_intent": {"enum": ["unsigned", "debug", "test", "distribution"]},
    "budget": {
      "type": "object",
      "required": ["max_package_mb", "max_build_seconds", "max_device_matrix_runs"],
      "properties": {
        "max_package_mb": {"type": "integer", "minimum": 1, "maximum": 20480},
        "max_build_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_device_matrix_runs": {"type": "integer", "minimum": 1, "maximum": 1000}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"android_application_id": {"type": "null"}}, "required": ["android_application_id"]},
      "then": {
        "properties": {
          "android_min_api": {"type": "null"},
          "android_target_api": {"type": "null"},
          "package_kinds": {"not": {"contains": {"enum": ["apk", "aab"]}}}
        }
      },
      "else": {
        "properties": {
          "android_min_api": {"type": "integer", "minimum": 1, "maximum": 1000},
          "android_target_api": {"type": "integer", "minimum": 1, "maximum": 1000},
          "package_kinds": {"contains": {"enum": ["apk", "aab"]}}
        }
      }
    },
    {
      "if": {"properties": {"apple_bundle_id": {"type": "null"}}, "required": ["apple_bundle_id"]},
      "then": {
        "properties": {
          "apple_min_version": {"type": "null"},
          "apple_target_version": {"type": "null"},
          "package_kinds": {"not": {"contains": {"enum": ["app", "xcarchive", "ipa"]}}}
        }
      },
      "else": {
        "properties": {
          "apple_min_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"},
          "apple_target_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"},
          "package_kinds": {"contains": {"enum": ["app", "xcarchive", "ipa"]}}
        }
      }
    }
  ],
  "additionalProperties": false
}
