{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/device-test-matrix.schema.json",
  "title": "R13 DeviceTestMatrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_id", "platform", "device_digests", "locales", "orientations"],
  "properties": {
    "matrix_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "platform": {"enum": ["android", "ios", "ipados"]},
    "device_digests": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "locales": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"}},
    "orientations": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["portrait", "landscape"]}}
  }
}
