{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r11/godot-cinematic-assembly-intent.schema.json",
  "title": "Kodepoia R11.9 Godot Cinematic Assembly Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence_id", "sequence_digest", "fps", "frames", "tracks", "command_policy_id"],
  "properties": {
    "sequence_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "frames": {"type": "integer", "minimum": 1, "maximum": 3600},
    "command_policy_id": {"const": "r11.9.godot.capture.v1"},
    "tracks": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "kind", "start_frame", "duration_frames", "ref_id"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"enum": ["camera", "body", "facial", "dialogue", "music", "sfx", "foley", "subtitle", "event"]},
          "start_frame": {"type": "integer", "minimum": 0},
          "duration_frames": {"type": "integer", "minimum": 1},
          "ref_id": {"type": ["string", "null"], "maxLength": 128}
        }
      }
    }
  }
}
