{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/android-workspace-manifest.schema.json",
  "title": "Kodepoia R13 Android Workspace Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_sha256",
    "dependency_evidence_sha256",
    "app_model_sha256",
    "dna_sha256",
    "product_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "app_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dna_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "product_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "ownership"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "ownership": {"enum": ["kodepoia", "user"]}
        }
      }
    }
  }
}
