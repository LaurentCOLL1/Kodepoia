{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r10-organic-profile-v1.schema.json",
  "title": "Kodepoia R10.8 Organic Asset Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile_id",
    "kind",
    "asset",
    "coordinates",
    "rig_id",
    "armature_id",
    "rig_profile_digest",
    "rig_semantic_digest",
    "pieces",
    "material_slots",
    "shape_keys",
    "semantic_zones",
    "required_deform_bones",
    "animation_bones",
    "qa"
  ],
  "properties": {
    "version": {"const": 1},
    "profile_id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["humanoid_biped", "quadruped"]},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "revision_id", "content_sha256"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"},
        "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_scale_meters", "forward_axis", "up_axis"],
      "properties": {
        "unit_scale_meters": {"const": 1.0},
        "forward_axis": {"const": "-Z"},
        "up_axis": {"const": "Y"}
      }
    },
    "rig_id": {"$ref": "#/$defs/id"},
    "armature_id": {"$ref": "#/$defs/id"},
    "rig_profile_digest": {"$ref": "#/$defs/sha256"},
    "rig_semantic_digest": {"$ref": "#/$defs/sha256"},
    "pieces": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"$ref": "#/$defs/piece"}},
    "material_slots": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/materialSlot"}},
    "shape_keys": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/shapeKey"}},
    "semantic_zones": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/zone"}},
    "required_deform_bones": {"$ref": "#/$defs/idArrayNonEmpty"},
    "animation_bones": {"$ref": "#/$defs/idArrayNonEmpty"},
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_piece_inventory", "exact_material_slots", "exact_shape_keys", "max_unmapped_deform_bones"],
      "properties": {
        "exact_piece_inventory": {"type": "boolean"},
        "exact_material_slots": {"type": "boolean"},
        "exact_shape_keys": {"type": "boolean"},
        "max_unmapped_deform_bones": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idArrayNonEmpty": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "piece": {
      "type": "object", "additionalProperties": false,
      "required": ["piece_id", "piece_type", "object_id", "mesh_id", "required"],
      "properties": {
        "piece_id": {"$ref": "#/$defs/id"}, "piece_type": {"enum": ["mesh", "armature"]}, "object_id": {"$ref": "#/$defs/id"},
        "mesh_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "required": {"type": "boolean"}
      }
    },
    "materialSlot": {
      "type": "object", "additionalProperties": false,
      "required": ["piece_id", "slot_id", "actual_name", "required"],
      "properties": {"piece_id": {"$ref": "#/$defs/id"}, "slot_id": {"$ref": "#/$defs/id"}, "actual_name": {"type": "string", "minLength": 1, "maxLength": 128}, "required": {"type": "boolean"}}
    },
    "shapeKey": {
      "type": "object", "additionalProperties": false,
      "required": ["piece_id", "key_id", "actual_name", "required"],
      "properties": {"piece_id": {"$ref": "#/$defs/id"}, "key_id": {"$ref": "#/$defs/id"}, "actual_name": {"type": "string", "minLength": 1, "maxLength": 128}, "required": {"type": "boolean"}}
    },
    "zone": {
      "type": "object", "additionalProperties": false,
      "required": ["zone_id", "bone_ids", "piece_ids"],
      "properties": {"zone_id": {"$ref": "#/$defs/id"}, "bone_ids": {"$ref": "#/$defs/idArrayNonEmpty"}, "piece_ids": {"$ref": "#/$defs/idArrayNonEmpty"}}
    }
  }
}
