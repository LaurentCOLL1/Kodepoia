{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.dev/schemas/youtube-research-v1.schema.json",
  "title": "Kodepoia R7.6 YouTube research evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video_id",
    "canonical_url",
    "metadata_status",
    "transcript_status",
    "metadata",
    "transcript",
    "metadata_reason",
    "transcript_reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
    "canonical_url": {
      "type": "string",
      "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
    },
    "metadata_status": {"$ref": "#/$defs/status"},
    "transcript_status": {"$ref": "#/$defs/status"},
    "metadata": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/metadata"}
      ]
    },
    "transcript": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/transcript"}
      ]
    },
    "metadata_reason": {"type": "string"},
    "transcript_reason": {"type": "string"}
  },
  "$defs": {
    "status": {
      "enum": [
        "unknown",
        "ready",
        "unavailable",
        "not_applicable",
        "blocked",
        "stale"
      ]
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_id", "start_ms", "title", "source"],
      "properties": {
        "marker_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_ms": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_id",
        "video_id",
        "title",
        "description",
        "channel_id",
        "channel_title",
        "published_at",
        "duration",
        "default_language",
        "default_audio_language",
        "tags",
        "chapter_markers"
      ],
      "properties": {
        "metadata_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "channel_id": {"type": "string"},
        "channel_title": {"type": "string"},
        "published_at": {"type": "string"},
        "duration": {"type": "string"},
        "default_language": {"type": "string"},
        "default_audio_language": {"type": "string"},
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "chapter_markers": {
          "type": "array",
          "items": {"$ref": "#/$defs/chapter"}
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_ms", "end_ms", "text"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "video_id",
        "language",
        "kind",
        "provider",
        "caption_id",
        "name",
        "last_updated",
        "segments"
      ],
      "properties": {
        "track_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
        "language": {"type": "string", "minLength": 1},
        "kind": {"enum": ["human", "automatic", "forced", "unknown"]},
        "provider": {"type": "string", "minLength": 1},
        "caption_id": {"type": "string"},
        "name": {"type": "string"},
        "last_updated": {"type": "string"},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        }
      }
    }
  }
}
