{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/android-scaffold-definition.schema.json",
  "title": "Kodepoia R13 Android Scaffold Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_id",
    "application_id",
    "namespace",
    "app_name",
    "min_sdk",
    "target_sdk",
    "dependency_evidence",
    "app_model_sha256",
    "string_catalogs",
    "source_kind"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "definition_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "application_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "app_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "min_sdk": {"type": "integer", "minimum": 1, "maximum": 1000},
    "target_sdk": {"type": "integer", "minimum": 1, "maximum": 1000},
    "app_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_kind": {"const": "native"},
    "dependency_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "android_gradle_plugin", "compose_bom", "compile_sdk", "observed_on", "source_urls"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
        "android_gradle_plugin": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"},
        "compose_bom": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$"},
        "compile_sdk": {"type": "integer", "minimum": 1, "maximum": 1000},
        "observed_on": {"type": "string", "format": "date"},
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://developer\\.android\\.com/"}
        }
      }
    },
    "string_catalogs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "values"],
        "properties": {
          "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
          "values": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
            "additionalProperties": {"type": "string", "maxLength": 2048}
          }
        }
      }
    }
  }
}
