{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/v2-4-1-accelerator-topology.schema.json",
  "title": "Kodepoia V2.4.1 accelerator topology report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "blockers",
    "disposition",
    "observed",
    "provider_request",
    "provider_request_digest",
    "report_digest",
    "request_digest",
    "schema",
    "schema_version",
    "stderr",
    "topology_digest"
  ],
  "properties": {
    "schema": {"const": "kodepoia.v2.4.1.accelerator-topology"},
    "schema_version": {"const": 1},
    "report_digest": {"$ref": "#/$defs/digest"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "topology_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "provider_request_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "backend": {"enum": ["cpu", "cuda", "rocm"]},
    "disposition": {"enum": ["ready", "mismatch", "unavailable", "failed"]},
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "stderr": {"type": "string", "maxLength": 8192},
    "provider_request": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_backend",
            "expected_device_count",
            "expected_name_contains",
            "provider",
            "shape"
          ],
          "properties": {
            "provider": {"type": "string", "minLength": 1, "maxLength": 128},
            "shape": {"type": "string", "minLength": 1, "maxLength": 128},
            "expected_backend": {"enum": ["cuda", "rocm"]},
            "expected_device_count": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 64
            },
            "expected_name_contains": {"type": ["string", "null"], "maxLength": 64}
          }
        }
      ]
    },
    "observed": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend_type", "device_count", "devices"],
          "properties": {
            "backend_type": {"enum": ["cuda", "rocm"]},
            "device_count": {"type": "integer", "minimum": 1, "maximum": 64},
            "devices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/device"}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_type",
        "index",
        "name",
        "vram_free_bytes",
        "vram_total_bytes"
      ],
      "properties": {
        "backend_type": {"enum": ["cuda", "rocm"]},
        "index": {"type": "integer", "minimum": 0, "maximum": 63},
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "vram_free_bytes": {"type": ["integer", "null"], "minimum": 0},
        "vram_total_bytes": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
