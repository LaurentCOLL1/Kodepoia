{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/patch-gate-report-v1.schema.json",
  "title": "Kodepoia Patch Gate Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "patch_id", "base_sha", "head_sha", "changes", "classification", "requirements", "evidence", "rollback", "rehearsal", "status", "blockers", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "patch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{1,191}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "classification": {"$ref": "#/$defs/classification"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "rollback": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rollback"}]},
    "rehearsal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rehearsal"}]},
    "status": {"enum": ["unknown", "pass", "warn", "fail"]},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "domain", "operation", "risk", "platforms", "destructive"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "domain": {"enum": ["core", "governance", "security", "schema", "public_api", "build", "dependencies", "ui", "visual", "accessibility", "localization", "privacy", "licenses", "performance", "assets", "tests", "documentation", "other"]},
        "operation": {"enum": ["add", "modify", "delete", "rename"]},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "platforms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "destructive": {"type": "boolean"}
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "triggers"],
      "properties": {
        "classification": {"enum": ["minor", "major"]},
        "triggers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "reason"],
      "properties": {
        "gate": {"enum": ["tests", "regression", "visual", "accessibility", "localization", "technical_debt", "ci_build", "security", "privacy", "license_bom", "health", "budget", "rollback"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "status", "source", "evidence_sha256", "source_sha", "rationale", "details"],
      "properties": {
        "gate": {"enum": ["tests", "regression", "visual", "accessibility", "localization", "technical_debt", "ci_build", "security", "privacy", "license_bom", "health", "budget", "rollback"]},
        "status": {"enum": ["pass", "warn", "fail", "skip", "cancelled", "missing", "not_applicable"]},
        "source": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "source_sha": {"type": "string", "pattern": "^$|^[0-9a-f]{40}$"},
        "rationale": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "method", "description", "restore_scope", "snapshot_required", "audit_required", "verification_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{1,191}$"},
        "method": {"enum": ["safe_change", "backup_restore", "recovery_journal", "composite"]},
        "description": {"type": "string", "minLength": 1},
        "restore_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "snapshot_required": {"type": "boolean"},
        "audit_required": {"type": "boolean"},
        "verification_required": {"type": "boolean"}
      }
    },
    "rehearsal": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source", "evidence_sha256", "restored_hashes_match", "backup_verified", "audit_chain_valid", "recovery_checkpoint_cleared", "details"],
      "properties": {
        "status": {"enum": ["not_run", "pass", "fail"]},
        "source": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "restored_hashes_match": {"type": "boolean"},
        "backup_verified": {"type": "boolean"},
        "audit_chain_valid": {"type": "boolean"},
        "recovery_checkpoint_cleared": {"type": "boolean"},
        "details": {"type": "object"}
      }
    }
  }
}
