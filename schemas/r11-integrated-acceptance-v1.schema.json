{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r11-integrated-acceptance-v1.schema.json",
  "title": "Kodepoia R11 integrated acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_sha",
    "continuity",
    "subdivisions",
    "local_evidence",
    "prior_phases",
    "status",
    "blockers",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256", "bytes"],
      "properties": {
        "source": {"const": "docs/continuity/KODEPOIA_CONTINUITY.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "subdivisions": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sha256", "bytes", "subdivision", "accepted_head", "manual_state", "manual_satisfied"],
        "properties": {
          "source": {"type": "string", "pattern": "^docs/roadmap/R11_(?:[1-9]|1[0-4])_ACCEPTANCE\\.md$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "subdivision": {"type": "string", "pattern": "^R11\\.(?:[1-9]|1[0-4])$"},
          "accepted_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "manual_state": {"enum": ["none", "required_satisfied", "conditional_not_triggered", "conditional_satisfied", "required_unsatisfied", "conditional_triggered_unsatisfied"]},
          "manual_satisfied": {"type": "boolean"}
        }
      }
    },
    "local_evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sha256", "bytes", "subdivision", "source_sha", "evidence_digest"],
        "properties": {
          "source": {"enum": ["docs/roadmap/R11_5_LOCAL_ACCEPTANCE.json", "docs/roadmap/R11_9_LOCAL_ACCEPTANCE.json"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "subdivision": {"enum": ["R11.5", "R11.9"]},
          "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "prior_phases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sha256", "bytes", "phase", "evidence_sha256"],
        "properties": {
          "source": {"type": "string", "pattern": "^docs/roadmap/R(?:7|8|9|10)_INTEGRATED_ACCEPTANCE\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "phase": {"enum": ["R7", "R8", "R9", "R10"]},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "status": {"enum": ["pass", "fail"]},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
