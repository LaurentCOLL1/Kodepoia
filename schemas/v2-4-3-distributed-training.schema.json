{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/v2-4-3-distributed-training.schema.json",
  "title": "Kodepoia V2.4.3 distributed training report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_digest",
    "adapter_path",
    "benchmark_report_digest",
    "blockers",
    "canonical_rank",
    "canonical_training_report_digest",
    "completed_steps",
    "device_ordinals",
    "eval_loss",
    "execution_plan_digest",
    "process_group_managed",
    "rank_evidence",
    "report_digest",
    "resume_authorized",
    "run_id",
    "schema",
    "schema_version",
    "state",
    "stderr",
    "strategy_plan_digest",
    "topology_digest",
    "train_loss",
    "training_plan_digest",
    "world_size"
  ],
  "properties": {
    "schema": {"const": "kodepoia.v2.4.3.distributed-training-report"},
    "schema_version": {"const": 1},
    "report_digest": {"$ref": "#/$defs/digest"},
    "execution_plan_digest": {"$ref": "#/$defs/digest"},
    "training_plan_digest": {"$ref": "#/$defs/digest"},
    "strategy_plan_digest": {"$ref": "#/$defs/digest"},
    "benchmark_report_digest": {"$ref": "#/$defs/digest"},
    "topology_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "state": {"enum": ["completed", "cancelled", "timed_out", "failed", "budget_blocked"]},
    "world_size": {"const": 2},
    "device_ordinals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 63}
    },
    "canonical_rank": {"const": 0},
    "rank_evidence": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/rankEvidence"}
    },
    "canonical_training_report_digest": {
      "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "adapter_path": {"type": ["string", "null"]},
    "adapter_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "completed_steps": {"type": "integer", "minimum": 0},
    "train_loss": {"type": ["number", "null"], "minimum": 0},
    "eval_loss": {"type": ["number", "null"], "minimum": 0},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stderr": {"type": "string"},
    "process_group_managed": {"const": true},
    "resume_authorized": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rankEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_output_digest",
        "completed_steps",
        "data_seed",
        "device_ordinal",
        "eval_loss",
        "execution_plan_digest",
        "failure_type",
        "local_rank",
        "peak_vram_bytes",
        "rank",
        "seed",
        "shared_sampler_seed",
        "state",
        "strategy_plan_digest",
        "topology_digest",
        "train_loss",
        "training_plan_digest",
        "world_size"
      ],
      "properties": {
        "execution_plan_digest": {"$ref": "#/$defs/digest"},
        "training_plan_digest": {"$ref": "#/$defs/digest"},
        "strategy_plan_digest": {"$ref": "#/$defs/digest"},
        "topology_digest": {"$ref": "#/$defs/digest"},
        "rank": {"type": "integer", "minimum": 0, "maximum": 1},
        "local_rank": {"type": "integer", "minimum": 0, "maximum": 1},
        "world_size": {"const": 2},
        "device_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "data_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "shared_sampler_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "state": {"enum": ["completed", "failed"]},
        "completed_steps": {"type": "integer", "minimum": 0},
        "train_loss": {"type": ["number", "null"], "minimum": 0},
        "eval_loss": {"type": ["number", "null"], "minimum": 0},
        "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "canonical_output_digest": {
          "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "failure_type": {"type": ["string", "null"]}
      }
    }
  }
}
