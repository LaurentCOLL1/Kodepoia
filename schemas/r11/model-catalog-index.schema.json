{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.invalid/schemas/r11/model-catalog-index.schema.json",
  "type": "object",
  "required": ["schema_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_id", "manifest"],
        "additionalProperties": false,
        "properties": {
          "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
          "manifest": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
