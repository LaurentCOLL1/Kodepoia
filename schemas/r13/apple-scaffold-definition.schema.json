{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r13/apple-scaffold-definition.schema.json",
  "title": "Kodepoia R13.9 Apple Scaffold Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definition_id",
    "bundle_id",
    "app_name",
    "minimum_os_version",
    "target_os_version",
    "form_factors",
    "app_model_sha256",
    "string_catalogs",
    "source_kind",
    "state_strategy",
    "godot_export_bridge"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "definition_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"},
    "app_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "minimum_os_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"},
    "target_os_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"},
    "form_factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["phone", "tablet"]}
    },
    "app_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_catalogs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locale", "values"],
        "properties": {
          "locale": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$"},
          "values": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 256,
            "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
            "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        }
      }
    },
    "source_kind": {"enum": ["native", "godot_export"]},
    "state_strategy": {"enum": ["observation", "observable_object_compat"]},
    "godot_export_bridge": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bridge_id", "export_preset", "expected_container_suffix", "execution_owned_by_r5"],
          "properties": {
            "bridge_id": {"const": "godot.ios.xcode-export"},
            "export_preset": {"const": "iOS"},
            "expected_container_suffix": {"const": ".xcodeproj"},
            "execution_owned_by_r5": {"const": true}
          }
        }
      ]
    }
  }
}
