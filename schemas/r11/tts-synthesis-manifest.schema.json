{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.invalid/schemas/r11/tts-synthesis-manifest.schema.json",
  "type": "object",
  "required": ["source_sha", "request_digest", "text_sha256", "cache_key", "backend_id", "runtime_executable_sha256", "runtime_help_sha256", "model_sha256", "config_sha256", "output_sha256", "output_bytes", "wav_facts", "qa", "process", "status", "blockers"],
  "additionalProperties": false,
  "properties": {
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_id": {"const": "piper-compatible"},
    "runtime_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_help_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_bytes": {"type": "integer", "minimum": 0, "maximum": 33554432},
    "wav_facts": {"type": "object"},
    "qa": {"type": "object"},
    "process": {
      "type": "object",
      "required": ["returncode", "timed_out", "cancelled", "stdout_bytes", "stderr_bytes"],
      "additionalProperties": false,
      "properties": {
        "returncode": {"type": "integer"},
        "timed_out": {"type": "boolean"},
        "cancelled": {"type": "boolean"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["pass", "fail"]},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  }
}
