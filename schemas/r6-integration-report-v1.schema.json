{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r6-integration-report-v1.schema.json",
  "title": "Kodepoia R6 Integration Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_sha",
    "subdivisions",
    "status",
    "blockers",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subdivisions": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/subdivision"}
    },
    "status": {"enum": ["unknown", "pass", "fail"]},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "subdivision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subdivision",
        "status",
        "source",
        "evidence_sha256",
        "accepted_head",
        "manual_satisfied"
      ],
      "properties": {
        "subdivision": {
          "enum": [
            "R6.1", "R6.2", "R6.3", "R6.4", "R6.5", "R6.6",
            "R6.7", "R6.8", "R6.9", "R6.10", "R6.11", "R6.12"
          ]
        },
        "status": {"enum": ["unknown", "pass", "fail"]},
        "source": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "accepted_head": {"type": "string", "pattern": "^$|^[0-9a-f]{40}$"},
        "manual_satisfied": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
          "then": {"properties": {"accepted_head": {"pattern": "^[0-9a-f]{40}$"}}}
        }
      ]
    }
  }
}
