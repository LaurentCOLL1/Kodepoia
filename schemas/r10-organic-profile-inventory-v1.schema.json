{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r10-organic-profile-inventory-v1.schema.json",
  "title": "Kodepoia R10.8 Organic Profile Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile_digest", "asset_revision_id", "coordinates", "rig_profile_digest", "rig_semantic_digest", "pieces", "material_slots", "shape_keys"],
  "properties": {
    "schema": {"const": "kodepoia.blender.organic_profile_inventory"},
    "version": {"const": 1},
    "profile_digest": {"$ref": "#/$defs/sha256"},
    "asset_revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
    "coordinates": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_scale_meters", "forward_axis", "up_axis"],
      "properties": {"unit_scale_meters": {"const": 1.0}, "forward_axis": {"const": "-Z"}, "up_axis": {"const": "Y"}}
    },
    "rig_profile_digest": {"$ref": "#/$defs/sha256"},
    "rig_semantic_digest": {"$ref": "#/$defs/sha256"},
    "pieces": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["piece_id", "piece_type", "object_id", "mesh_id"],
        "properties": {
          "piece_id": {"$ref": "#/$defs/id"}, "piece_type": {"enum": ["mesh", "armature"]}, "object_id": {"$ref": "#/$defs/id"},
          "mesh_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "vertex_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "material_slots": {
      "type": "array", "maxItems": 512,
      "items": {"type": "object", "additionalProperties": false, "required": ["piece_id", "slot_id", "actual_name"], "properties": {"piece_id": {"$ref": "#/$defs/id"}, "slot_id": {"$ref": "#/$defs/id"}, "actual_name": {"type": "string", "minLength": 1, "maxLength": 128}}}
    },
    "shape_keys": {
      "type": "array", "maxItems": 2048,
      "items": {"type": "object", "additionalProperties": false, "required": ["piece_id", "key_id", "actual_name", "vertex_count"], "properties": {"piece_id": {"$ref": "#/$defs/id"}, "key_id": {"$ref": "#/$defs/id"}, "actual_name": {"type": "string", "minLength": 1, "maxLength": 128}, "vertex_count": {"type": "integer", "minimum": 1}}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
