{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/comfy-vram-evidence-payload-v1.schema.json",
  "title": "Kodepoia R9.8 VRAM evidence payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_head",
    "status",
    "endpoint",
    "capability_identity_sha256",
    "comfyui_version",
    "device",
    "resource_profile",
    "scheduler_trace",
    "workflow_definition_id",
    "workflow_instance_digest_sha256",
    "run_id",
    "run_manifest_digest_sha256",
    "output_sha256",
    "output_length",
    "memory_observation",
    "terminal_cleanup",
    "ollama_state",
    "ollama_reason",
    "ollama_restored",
    "resource_audit_relative_path",
    "resource_audit_valid",
    "lifecycle_audit_valid",
    "failure_reason",
    "evidence_digest_sha256"
  ],
  "properties": {
    "candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["pass", "fail"]},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 2048},
    "capability_identity_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "comfyui_version": {"type": ["string", "null"], "maxLength": 256},
    "device": {"type": ["object", "null"]},
    "resource_profile": {"type": "object"},
    "scheduler_trace": {"type": ["object", "null"]},
    "workflow_definition_id": {"type": ["string", "null"], "pattern": "^wf_[0-9a-f]{32}$"},
    "workflow_instance_digest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": ["string", "null"], "pattern": "^run_[0-9a-f]{32}$"},
    "run_manifest_digest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "output_length": {"type": ["integer", "null"], "minimum": 1},
    "memory_observation": {"type": ["object", "null"]},
    "terminal_cleanup": {"type": ["object", "null"]},
    "ollama_state": {"enum": ["tested", "n/a", "unavailable"]},
    "ollama_reason": {"type": "string", "minLength": 1, "maxLength": 2048},
    "ollama_restored": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "resource_audit_relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "resource_audit_valid": {"type": "boolean"},
    "lifecycle_audit_valid": {"type": "boolean"},
    "failure_reason": {"type": ["string", "null"], "maxLength": 4096},
    "evidence_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
