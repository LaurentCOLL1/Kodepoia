{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/research-query-cache-v1.schema.json",
  "title": "Kodepoia Research Query Cache v1",
  "type": "object",
  "required": ["schema_version", "request_id", "query_sha256", "project_scope_sha256", "source_kinds", "max_results", "target_constraint_id", "version_fingerprints", "policy_digest", "cache_key"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/sha256"},
    "query_sha256": {"$ref": "#/$defs/sha256"},
    "project_scope_sha256": {"$ref": "#/$defs/sha256"},
    "source_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local", "official_docs", "web", "github", "community", "youtube"]}},
    "max_results": {"type": "integer", "minimum": 1, "maximum": 100},
    "target_constraint_id": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "version_fingerprints": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "policy_digest": {"$ref": "#/$defs/sha256"},
    "cache_key": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
