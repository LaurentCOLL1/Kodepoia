{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/project-dna-v1.schema.json",
  "title": "Kodepoia Project DNA v1",
  "type": "object",
  "required": ["schema_version", "name", "project_type", "platforms"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "project_type": {"enum": ["game", "desktop_app", "tool", "plugin", "library", "ai_project", "other"]},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["windows", "linux", "macos", "android", "ios", "web", "steam_deck", "xr"]}},
    "engine": {"type": ["string", "null"]},
    "engine_version": {"type": ["string", "null"]},
    "dimension": {"enum": ["2d", "2.5d", "3d", "hybrid", null]},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "performance": {"type": "object"}
  },
  "additionalProperties": true
}
