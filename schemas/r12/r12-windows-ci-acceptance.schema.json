{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r12/r12-windows-ci-acceptance.schema.json",
  "title": "Kodepoia R12.16 Wizard-to-Windows CI acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_sha",
    "project_type",
    "platform",
    "framework",
    "architecture",
    "package_kind",
    "project_dna_sha256",
    "product_sha256",
    "workspace_manifest_sha256",
    "model_sha256",
    "package_manifest_sha256",
    "artifact_count",
    "build_returncode",
    "test_returncode",
    "test_sentinel",
    "status",
    "blockers",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project_type": {"const": "desktop_app"},
    "platform": {"const": "windows"},
    "framework": {"const": "wpf"},
    "architecture": {"const": "x64"},
    "package_kind": {"const": "archive"},
    "project_dna_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "product_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_count": {"type": "integer", "minimum": 1},
    "build_returncode": {"const": 0},
    "test_returncode": {"const": 0},
    "test_sentinel": {"type": "string", "pattern": "^KODEPOIA_WPF_TEST_PASS:[0-9a-f]{64}$"},
    "status": {"const": "pass"},
    "blockers": {"type": "array", "maxItems": 0},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
