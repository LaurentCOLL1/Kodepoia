{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r12/desktop-template-manifest.schema.json",
  "title": "Kodepoia R12 desktop template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "template_version", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "template_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "template_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_template", "content_template", "ownership"],
        "properties": {
          "path_template": {"type": "string", "minLength": 1},
          "content_template": {"type": "string"},
          "ownership": {"enum": ["kodepoia", "user"]}
        }
      }
    }
  }
}
