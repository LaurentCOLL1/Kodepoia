{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/store-compliance-v1.schema.json",
  "title": "Kodepoia Store Compliance Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha",
    "evaluated_on",
    "context",
    "ruleset_sha256",
    "input_sha256",
    "applicable_rules",
    "findings",
    "state",
    "current_policy_claim",
    "current_rule_ids",
    "noncurrent_rule_ids",
    "account_confirmations",
    "blockers",
    "legal_certification",
    "live_account_query_attempted"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evaluated_on": {"type": "string", "format": "date"},
    "context": {"$ref": "#/$defs/context"},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "applicable_rules": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/rule"}
    },
    "findings": {
      "type": "array",
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/finding"}
    },
    "state": {"enum": ["READY", "READY_WITH_WARNINGS", "BLOCKED", "INDETERMINATE"]},
    "current_policy_claim": {"type": "boolean"},
    "current_rule_ids": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "noncurrent_rule_ids": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "account_confirmations": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "blockers": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "legal_certification": {"const": false},
    "live_account_query_attempted": {"const": false}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "factKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "platform": {"enum": ["android", "ios", "ipados"]},
    "provider": {"enum": ["GOOGLE_PLAY", "APPLE_APP_STORE"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "regions", "app_categories"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/platform"}
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:GLOBAL|[A-Z]{2})$"}
        },
        "app_categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    },
    "expected": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "string", "maxLength": 2048},
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "provider",
        "requirement",
        "operator",
        "expected",
        "source_url",
        "source_sha256",
        "retrieved_on",
        "effective_from",
        "expires_on",
        "freshness_days",
        "scope",
        "severity",
        "remediation",
        "account_only"
      ],
      "properties": {
        "rule_id": {"$ref": "#/$defs/stableId"},
        "provider": {"$ref": "#/$defs/provider"},
        "requirement": {"$ref": "#/$defs/factKey"},
        "operator": {"enum": ["PRESENT", "TRUE", "MIN_INTEGER", "EQUALS", "CONTAINS_ALL"]},
        "expected": {"$ref": "#/$defs/expected"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "retrieved_on": {"type": "string", "format": "date"},
        "effective_from": {"type": "string", "format": "date"},
        "expires_on": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "freshness_days": {"type": "integer", "minimum": 1, "maximum": 366},
        "scope": {"$ref": "#/$defs/scope"},
        "severity": {"enum": ["INFO", "WARNING", "BLOCKER"]},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 1024},
        "account_only": {"type": "boolean"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "platform", "region", "app_category", "account_connected"],
      "properties": {
        "provider": {"$ref": "#/$defs/provider"},
        "platform": {"$ref": "#/$defs/platform"},
        "region": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "app_category": {"$ref": "#/$defs/stableId"},
        "account_connected": {"type": "boolean"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id",
        "requirement",
        "status",
        "severity",
        "currentness",
        "message",
        "remediation"
      ],
      "properties": {
        "finding_id": {"$ref": "#/$defs/stableId"},
        "rule_id": {
          "oneOf": [
            {"$ref": "#/$defs/stableId"},
            {"type": "null"}
          ]
        },
        "requirement": {"$ref": "#/$defs/factKey"},
        "status": {"enum": ["PASS", "FAIL", "NOT_CURRENT", "NEEDS_ACCOUNT_CONFIRMATION", "CONFLICT"]},
        "severity": {"enum": ["INFO", "WARNING", "BLOCKER"]},
        "currentness": {
          "oneOf": [
            {"enum": ["CURRENT", "FUTURE", "EXPIRED", "STALE", "UNOFFICIAL"]},
            {"type": "null"}
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  }
}
