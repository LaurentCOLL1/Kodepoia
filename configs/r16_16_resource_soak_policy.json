{
  "schema_version": 1,
  "policy_id": "r16.16-resource-concurrency-leak-diagnostics-v1",
  "repeat_runs": 2,
  "concurrency_workers": 4,
  "child_processes": 2,
  "required_capacities": [
    "cpu",
    "ram",
    "disk",
    "process",
    "time",
    "concurrency"
  ],
  "optional_capacities": [
    "vram"
  ],
  "budgets": {
    "max_wall_ms": 20000.0,
    "max_cpu_ms": 15000.0,
    "max_rss_growth_bytes": 268435456,
    "max_heap_growth_bytes": 33554432,
    "max_peak_heap_bytes": 67108864,
    "max_peak_temp_bytes": 8388608,
    "max_temp_bytes_after": 0,
    "max_temp_files_after": 0,
    "max_thread_delta_after": 1,
    "max_active_processes_after": 0,
    "max_repeat_wall_ratio": 20.0,
    "max_repeat_cpu_ratio": 20.0,
    "min_repeat_cpu_sample_ms": 50.0,
    "timeout_seconds": 30.0
  },
  "diagnostics": {
    "aggregate_only": true,
    "redact_sensitive_values": true,
    "persist_raw_fixture_content": false,
    "persist_absolute_paths": false
  }
}
