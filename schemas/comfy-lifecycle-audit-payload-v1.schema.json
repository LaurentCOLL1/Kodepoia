{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/comfy-lifecycle-audit-payload-v1.schema.json",
  "title": "Kodepoia ComfyUI lifecycle audit payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "run_manifest_digest_sha256", "endpoint", "events", "audit_digest_sha256"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "run_manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 2048},
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/event"}
    },
    "audit_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "action", "outcome", "observed_state", "request_digest_sha256", "response_digest_sha256", "previous_event_digest_sha256", "event_digest_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "action": {"enum": ["none", "job_cancel", "queue_delete", "targeted_interrupt", "recover", "free_request"]},
        "outcome": {"enum": ["noop", "dispatched", "reconciled", "ambiguous", "blocked", "unsupported"]},
        "observed_state": {"enum": ["unknown", "prepared", "queued", "running", "succeeded", "failed", "cancelled"]},
        "request_digest_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "response_digest_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "previous_event_digest_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "event_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
