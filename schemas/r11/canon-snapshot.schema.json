{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodepoia.local/schemas/r11/canon-snapshot.schema.json",
  "title": "Kodepoia R11 Canon Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "franchise_dna_id", "records", "previous_snapshot_digest"],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "subject", "predicate", "value", "authority", "status", "source_refs", "content_version", "valid_from", "valid_to", "supersedes", "deprecates"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject": {"type": "string", "minLength": 1, "maxLength": 256},
        "predicate": {"type": "string", "minLength": 1, "maxLength": 256},
        "value": {},
        "authority": {"enum": ["RESEARCH", "PROJECT", "FRANCHISE"]},
        "status": {"enum": ["PROPOSED", "REVIEWED", "CANONICAL", "DEPRECATED"]},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "content_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "valid_from": {"type": ["integer", "null"], "minimum": 0},
        "valid_to": {"type": ["integer", "null"], "minimum": 0},
        "supersedes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "deprecates": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  },
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "franchise_dna_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/record"}},
    "previous_snapshot_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
